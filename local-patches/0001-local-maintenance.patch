+            git_cmd, PROJECT_ROOT, latest_tag
+        )
+    except RuntimeError as exc:
+        print(f"✗ Could not resolve Release {latest_tag}.")
+        print(f"  {exc}")
+        sys.exit(1)
+
+    release_merged = subprocess.run(
