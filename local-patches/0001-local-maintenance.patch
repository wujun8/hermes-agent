+                message="You exceeded your current quota",
+            )
+
+        result = _run_with_mocked_transport(agent, fake_api_call)
+
+        assert result["completed"] is True
+        assert calls == [
+            ("custom", "primary-model"),
+            ("custom", "fallback-model"),
+        ]
