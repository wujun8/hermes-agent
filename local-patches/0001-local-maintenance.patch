+        "common_dir",
+        "symbolic_head",
+        "head_sha",
+        "head_tree_sha",
+        "maintenance_ref",
+        "maintenance_ref_sha",
+        "index_tree_sha",
+        "tracked_diff_sha256",
+        "status_v2_sha256",
+        "untracked_count",
+    }
+)
+_RELEASE_SNAPSHOT_MAX_PATH = 4096
+_RELEASE_SNAPSHOT_MAX_REF = 1024
+_RELEASE_SNAPSHOT_MAX_UNTRACKED = 100_000
+_RELEASE_EMPTY_DIGEST = hashlib.sha256(b"").hexdigest()
+_RELEASE_MAINTENANCE_REF = "refs/heads/hermes-release"
